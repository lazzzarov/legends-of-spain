---
import '../styles/global.css';
import SEO from '../components/layout/SEO.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}
const props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#3B2416" />
    <SEO {...props} />
    <slot name="head" />
  </head>
  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only z-50 bg-cream px-4 py-2 font-ui focus:not-sr-only focus:absolute focus:top-2 focus:left-2"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
