---
import WaxSeal from '../ornaments/WaxSeal.astro';
import { withBase } from '../../lib/paths';

const links = [
  { href: withBase('legends/'), label: 'All legends' },
  { href: withBase('why/'), label: 'Why We Tell These Stories' },
  { href: withBase('credits/'), label: 'Credits' },
];
const current = Astro.url.pathname;
---

<header class="relative z-30 border-b-2 border-gold bg-umber text-parchment">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-4 sm:px-6">
    <a
      href={withBase()}
      class="flex items-center gap-3 text-parchment no-underline hover:text-mist"
    >
      <WaxSeal />
      <span class="font-display text-2xl">Legends of Spain</span>
    </a>
    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex gap-x-6 font-ui text-[15px]" role="list">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class="inline-flex min-h-11 items-center text-parchment no-underline hover:text-mist aria-[current=page]:underline"
              aria-current={current.startsWith(l.href) ? 'page' : undefined}
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <!-- Small screens: the same links in a disclosure menu (works without JavaScript). -->
    <details class="group relative md:hidden">
      <summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded text-parchment [&::-webkit-details-marker]:hidden">
        <span class="sr-only">Menu</span>
        <svg
          class="size-6 group-open:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg
          class="hidden size-6 group-open:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </summary>
      <nav
        aria-label="Main (menu)"
        class="absolute top-full right-0 mt-2 w-64 border border-gold bg-umber p-2 shadow-lift"
      >
        <ul class="flex flex-col font-ui text-base" role="list">
          {links.map((l) => (
            <li>
              <a
                href={l.href}
                class="flex min-h-11 items-center px-3 text-parchment no-underline hover:bg-ink aria-[current=page]:underline"
                aria-current={current.startsWith(l.href) ? 'page' : undefined}
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>
