---
import { Image } from 'astro:assets';
import type { LegendEntry } from '../../lib/content';
import { initials, resolveImage } from '../../lib/media';
import { legendPath } from '../../lib/paths';
import { buildScale, toTimeline } from '../../lib/timeline';

/**
 * The full timeline: one row per legend, ordered by key event. The text column carries
 * every fact (name, dates, event), so the drawn bars are decoration and hidden from
 * assistive technology. The list is filterable by the gallery's filter chips.
 */
interface Props {
  legends: LegendEntry[];
}
const items = toTimeline(Astro.props.legends);
const scale = items.length > 0 ? buildScale(items) : undefined;
const pct = (n: number) => `${n.toFixed(3)}%`;
// Plain years keep the rows short; exact and disputed dates are on each legend's page.
const years = (dates: LegendEntry['data']['dates']) =>
  `${dates.born.approx ? 'c. ' : ''}${dates.born.year}–${dates.died.approx ? 'c. ' : ''}${dates.died.year}`;
const ROW = 'grid items-center gap-x-8 gap-y-2 lg:grid-cols-[minmax(0,23rem)_minmax(0,1fr)]';
---

{scale && (
  <div>
    <p
      class="m-0 mb-4 flex flex-wrap gap-x-6 gap-y-1 font-ui text-sm text-burnt"
      aria-hidden="true"
    >
      <span class="inline-flex items-center gap-2">
        <span class="inline-block h-2 w-8 bg-caramel" /> Lifetime
      </span>
      <span class="inline-flex items-center gap-2">
        <span class="inline-block size-3.5 rounded-full bg-burgundy" /> Defining moment
      </span>
    </p>

    {/* Axis: century marks always, half-century marks from small screens up. */}
    <div class:list={[ROW, 'border-b border-sepia pb-1']} aria-hidden="true">
      <span class="hidden lg:block" />
      <div class="relative h-6 font-ui text-xs text-burnt">
        {scale.ticks.slice(1, -1).map((year) => (
          <span
            class:list={['absolute -translate-x-1/2', year % 100 !== 0 && 'hidden sm:inline']}
            style={`left:${pct(scale.position(year))}`}
          >
            {year}
          </span>
        ))}
      </div>
    </div>

    <ol class="m-0 list-none p-0" data-gallery data-timeline>
      {items.map((item) => {
        const d = item.legend.data;
        const media = d.media.find((m) => m.id === d.portrait)!;
        const image = resolveImage(item.slug, media.file);
        return (
          <li
            class:list={[ROW, 'relative border-b border-dashed border-caramel py-4']}
            data-category={d.categories.join(' ')}
            data-century={d.centuries.join(' ')}
            data-value={d.values.join(' ')}
            data-event-year={item.eventYear}
          >
            <div class="flex items-center gap-4">
              {image ? (
                <Image
                  src={image}
                  alt=""
                  width={112}
                  height={112}
                  class="size-14 shrink-0 rounded-full border border-burnt object-cover object-[50%_12%]"
                />
              ) : (
                <span
                  class="plate flex size-14 shrink-0 items-center justify-center rounded-full border border-burnt font-display text-xl text-burnt/70"
                  aria-hidden="true"
                >
                  {initials(item.name)}
                </span>
              )}
              <div class="flex min-w-0 flex-col gap-0.5">
                <h3 class="m-0 font-display text-2xl leading-tight font-normal text-umber">
                  <a
                    href={legendPath(item.slug)}
                    class="text-umber no-underline after:absolute after:inset-0 after:content-[''] hover:text-burgundy"
                  >
                    {item.name}
                  </a>
                </h3>
                <p class="m-0 font-ui text-[13px] text-burnt">
                  {d.role} · {years(d.dates)}
                </p>
                <p class="m-0 text-[17px] leading-snug text-umber">
                  <strong class="font-sc text-lg font-normal text-burgundy">
                    {item.eventYear}
                  </strong>
                  <span aria-hidden="true"> · </span>
                  <span class="sr-only">: </span>
                  {item.eventLabel}
                </p>
              </div>
            </div>

            <div class="relative h-9" aria-hidden="true">
              {scale.ticks.slice(1, -1).map((year) => (
                <span
                  class:list={[
                    'absolute inset-y-0 w-px bg-sepia/50',
                    year % 100 !== 0 && 'hidden sm:block',
                  ]}
                  style={`left:${pct(scale.position(year))}`}
                />
              ))}
              <span
                class="absolute top-1/2 h-2 -translate-y-1/2 bg-caramel"
                style={`left:${pct(scale.position(item.born))};width:${pct(
                  scale.position(item.died) - scale.position(item.born),
                )}`}
              />
              <span
                class="absolute top-1/2 size-4 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-cream bg-burgundy shadow-[0_1px_2px_rgb(0_0_0/0.4)]"
                style={`left:${pct(scale.position(item.eventYear))}`}
              />
            </div>
          </li>
        );
      })}
    </ol>
  </div>
)}
