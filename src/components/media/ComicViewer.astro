---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import MediaKindLabel from './MediaKindLabel.astro';
import SectionHeading from '../story/SectionHeading.astro';
import VerificationBadge from '../story/VerificationBadge.astro';
import { resolveImage } from '../../lib/media';
import type { Legend } from '../../lib/schema';

/**
 * The comic as a horizontal scroll-snap strip: native swipe on touch screens, arrow-key
 * scrolling when focused, and fully readable without JavaScript. A small script adds the
 * previous/next buttons and the "Panels 1–2 of 8" status.
 */
interface Props {
  slug: string;
  comic: NonNullable<Legend['comic']>;
  media: Legend['media'];
  /** Pre-resolved images by media id (used by the styleguide's fixtures). */
  images?: Record<string, ImageMetadata>;
}
const { slug, comic, media, images = {} } = Astro.props;
const mediaById = new Map(media.map((m) => [m.id, m]));
const total = comic.panels.length;
const imageFor = (id: string | undefined) =>
  id ? (images[id] ?? resolveImage(slug, mediaById.get(id)?.file)) : undefined;

// Large versions for the "Enlarge" dialog, only for panels whose illustration exists.
const enlarged = new Map<number, string>();
for (const [i, panel] of comic.panels.entries()) {
  const image = imageFor(panel.image);
  if (image) enlarged.set(i, (await getImage({ src: image, width: 1600 })).src);
}
---

<section data-reveal aria-labelledby="comic" class="scroll-mt-6" data-comic>
  <div class="flex flex-wrap items-end justify-between gap-2">
    <SectionHeading id="comic">The Comic</SectionHeading>
    <p class="mb-5 font-ui text-sm text-burnt" aria-live="polite" data-comic-status>
      {total} panels
    </p>
  </div>

  <ol
    class="m-0 flex list-none snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth p-0 pb-3 motion-reduce:scroll-auto"
    tabindex="0"
    aria-label="Comic panels — scroll or use the arrow keys"
    data-comic-track
  >
    {comic.panels.map((panel, i) => {
      const art = panel.image ? mediaById.get(panel.image) : undefined;
      const image = imageFor(panel.image);
      return (
        <li
          class="w-full shrink-0 snap-start lg:w-[calc(50%-10px)]"
          aria-label={`Panel ${i + 1} of ${total}`}
          data-comic-panel
        >
          <figure class="m-0 flex h-full flex-col border-2 border-ink bg-cream">
            <div class:list={['relative aspect-[4/3] border-b-2 border-ink', !image && 'plate']}>
              {image && art ? (
                <button
                  type="button"
                  class="group block h-full w-full cursor-zoom-in"
                  aria-label={`Enlarge panel ${i + 1}`}
                  data-comic-enlarge={enlarged.get(i)}
                  data-alt={art.alt}
                  data-caption={panel.caption}
                >
                  <Image
                    src={image}
                    alt={art.alt}
                    widths={[400, 600, 800]}
                    sizes="(min-width: 1024px) 400px, 90vw"
                    class="h-full w-full object-cover"
                  />
                  <span
                    class="absolute top-2 right-2 bg-cream/90 px-2 py-1 font-ui text-[11px] font-semibold text-umber opacity-0 transition group-hover:opacity-100 group-focus-visible:opacity-100"
                    aria-hidden="true"
                  >
                    ⤢ Enlarge
                  </span>
                </button>
              ) : (
                <span class="absolute inset-0 flex items-center justify-center p-6 text-center font-ui text-sm text-burnt">
                  Illustration in production
                </span>
              )}
              {art && image && (
                <MediaKindLabel
                  kind={art.kind}
                  posthumous={art.posthumous}
                  class="absolute top-2 left-2"
                />
              )}
              <span class="absolute right-2 bottom-2 bg-ink px-2 py-0.5 font-ui text-[11px] text-parchment">
                {i + 1}
              </span>
            </div>
            <figcaption class="flex grow flex-col gap-2 p-4">
              <p class="m-0 text-base leading-normal">{panel.caption}</p>
              {panel.dialogue.map((d) => (
                <p class="m-0 border-l-2 border-sepia pl-3 text-[15px] italic">
                  <span class="font-ui text-xs font-semibold not-italic">{d.speaker}:</span>{' '}
                  {`“${d.text}”`}{' '}
                  {d.kind === 'dramatized' && <VerificationBadge status="dramatization" />}
                </p>
              ))}
              {panel.context && <p class="m-0 font-ui text-[13px] text-burnt">{panel.context}</p>}
              {panel.note && (
                <details class="mt-auto">
                  <summary class="inline-flex min-h-11 cursor-pointer items-center font-ui text-[13px] font-semibold text-burgundy">
                    ❖ Historical note
                  </summary>
                  <p class="m-0 text-[15px] leading-normal">{panel.note}</p>
                </details>
              )}
            </figcaption>
          </figure>
        </li>
      );
    })}
  </ol>

  <div class="mt-2 flex justify-between gap-3" data-comic-controls hidden>
    <button
      type="button"
      class="btn-secondary min-h-11 text-base disabled:opacity-40"
      data-comic-prev
    >
      <span aria-hidden="true">←</span> Previous
    </button>
    <button
      type="button"
      class="btn-primary min-h-11 text-base disabled:opacity-40"
      data-comic-next
    >
      Next <span aria-hidden="true">→</span>
    </button>
  </div>

  {enlarged.size > 0 && (
    <dialog
      class="m-auto max-h-[92vh] max-w-[min(1100px,94vw)] border-2 border-ink bg-cream p-0 backdrop:bg-ink/80"
      aria-label="Enlarged comic panel"
      data-comic-dialog
    >
      <figure class="m-0 flex flex-col">
        <img src="" alt="" class="max-h-[78vh] w-full object-contain" data-comic-dialog-image />
        <figcaption class="flex items-start justify-between gap-4 p-4">
          <p class="m-0 text-base leading-normal" data-comic-dialog-caption></p>
          <form method="dialog" class="shrink-0">
            <button type="submit" class="btn-secondary min-h-11 text-base" autofocus>
              Close
            </button>
          </form>
        </figcaption>
      </figure>
    </dialog>
  )}
</section>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const root of document.querySelectorAll<HTMLElement>('[data-comic]')) {
    const track = root.querySelector<HTMLElement>('[data-comic-track]')!;
    const panels = [...track.querySelectorAll<HTMLElement>('[data-comic-panel]')];
    const status = root.querySelector<HTMLElement>('[data-comic-status]')!;
    const controls = root.querySelector<HTMLElement>('[data-comic-controls]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-comic-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-comic-next]')!;
    controls.hidden = false;

    const step = () =>
      panels[0]!.getBoundingClientRect().width +
      parseFloat(getComputedStyle(track).columnGap || '0');
    const perView = () => Math.max(1, Math.round(track.clientWidth / step()));

    const update = () => {
      const first = Math.round(track.scrollLeft / step());
      const last = Math.min(panels.length, first + perView());
      status.textContent =
        last - first > 1
          ? `Panels ${first + 1}–${last} of ${panels.length}`
          : `Panel ${first + 1} of ${panels.length}`;
      prev.disabled = first <= 0;
      next.disabled = last >= panels.length;
    };

    const go = (direction: 1 | -1) =>
      track.scrollBy({
        left: direction * step() * perView(),
        behavior: reduceMotion.matches ? 'auto' : 'smooth',
      });

    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));

    // Arrow keys move a whole view at a time (aligned to panels); Home/End jump to the ends.
    track.addEventListener('keydown', (e) => {
      if (e.target !== track) return;
      const keys: Record<string, () => void> = {
        ArrowRight: () => go(1),
        ArrowLeft: () => go(-1),
        Home: () => track.scrollTo({ left: 0 }),
        End: () => track.scrollTo({ left: track.scrollWidth }),
      };
      const action = keys[e.key];
      if (action) {
        e.preventDefault();
        action();
      }
    });

    // Enlarge: a native modal <dialog> (Esc closes it and focus returns to the panel).
    const dialog = root.querySelector<HTMLDialogElement>('[data-comic-dialog]');
    if (dialog) {
      const img = dialog.querySelector<HTMLImageElement>('[data-comic-dialog-image]')!;
      const caption = dialog.querySelector<HTMLElement>('[data-comic-dialog-caption]')!;
      let opener: HTMLElement | null = null;
      root.addEventListener('click', (e) => {
        const button = (e.target as Element).closest<HTMLButtonElement>('[data-comic-enlarge]');
        if (!button) return;
        opener = button;
        img.src = button.dataset.comicEnlarge!;
        img.alt = button.dataset.alt ?? '';
        caption.textContent = button.dataset.caption ?? '';
        dialog.showModal();
      });
      // Clicking the backdrop (outside the figure) closes the dialog.
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });
      dialog.addEventListener('close', () => opener?.focus());
    }
    let frame = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(update);
    });
    window.addEventListener('resize', update);
    update();
  }
</script>
