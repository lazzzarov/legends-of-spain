---
import SectionHeading from './SectionHeading.astro';
import type { CitationIndex } from '../../lib/citations';
import type { Legend } from '../../lib/schema';

interface Props {
  sources: Legend['sources'];
  backlinks: CitationIndex['backlinks'];
}
const { sources, backlinks } = Astro.props;
const TYPE_LABEL = {
  primary: 'Primary record',
  academic: 'Scholarship',
  institutional: 'Institution',
  reference: 'Reference',
} as const;
---

<section data-reveal aria-labelledby="sources" class="scroll-mt-6 border-t border-sepia pt-6">
  <SectionHeading id="sources">Sources</SectionHeading>
  <ol class="m-0 flex flex-col gap-4 pl-6 text-[15px] leading-relaxed">
    {sources.map((s, i) => {
      const refs = backlinks.get(i + 1) ?? [];
      return (
        <li
          id={`source-${i + 1}`}
          class="scroll-mt-24 pl-1 target:bg-cream target:outline target:outline-caramel"
        >
          <span class="font-ui text-[11px] font-semibold tracking-wide text-burnt uppercase">
            {TYPE_LABEL[s.type]}
          </span>
          <p class="m-0">
            {s.url ? <a href={s.url}>{s.title}</a> : <cite class="not-italic">{s.title}</cite>}
            {(s.author ?? s.institution) && <>. {s.author ?? s.institution}</>}
            {s.publisher && <>, {s.publisher}</>}
            {s.year && <>, {s.year}</>}.
          </p>
          {s.notes && <p class="m-0 font-ui text-xs text-burnt">{s.notes}</p>}
          {refs.length > 0 && (
            <p class="m-0 mt-0.5 font-ui text-xs text-burnt">
              Cited in:{' '}
              {refs.map((r, k) => (
                <>
                  {k > 0 && ', '}
                  <a href={`#${r.id}`}>{r.label}</a>
                </>
              ))}
            </p>
          )}
        </li>
      );
    })}
  </ol>
</section>
