---
/**
 * Reading aids for a story page:
 * - a thin reading-progress bar (decorative, aria-hidden);
 * - on small screens, a sticky "In this chapter" menu (the side contents is desktop-only);
 * - a script that marks the current section in every contents list (aria-current="location").
 * Without JavaScript the menu still works as a plain <details> list of links.
 */
interface Props {
  items: { id: string; label: string }[];
}
const { items } = Astro.props;
---

<div
  class="pointer-events-none fixed inset-x-0 top-0 z-40 h-[3px] origin-left scale-x-0 bg-burgundy"
  aria-hidden="true"
  data-reading-progress
></div>

<details
  class="group sticky top-0 z-30 border-b border-caramel bg-cream/95 font-ui text-sm backdrop-blur lg:hidden"
  data-story-menu
>
  <summary class="mx-auto flex min-h-12 max-w-6xl cursor-pointer list-none items-center justify-between gap-3 px-4 sm:px-6 [&::-webkit-details-marker]:hidden">
    <span class="flex min-w-0 items-center gap-2">
      <span class="eyebrow shrink-0">In this chapter</span>
      <span class="truncate text-umber" data-story-menu-current>
        {items[0]?.label}
      </span>
    </span>
    <span aria-hidden="true" class="text-burgundy transition-transform group-open:rotate-180">
      ▾
    </span>
  </summary>
  <nav aria-label="In this chapter (menu)" class="mx-auto max-w-6xl px-4 pb-3 sm:px-6">
    <ol class="m-0 flex list-none flex-col border-l border-sepia p-0 pl-4" role="list">
      {items.map((item) => (
        <li>
          <a
            href={`#${item.id}`}
            class="flex min-h-11 items-center text-umber no-underline aria-[current=location]:font-semibold aria-[current=location]:text-burgundy"
            data-toc-link
          >
            {item.label}
          </a>
        </li>
      ))}
    </ol>
  </nav>
</details>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const ids = [...new Set(links.map((a) => a.hash.slice(1)))];
  const targets = ids
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => !!el);
  const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
  const menu = document.querySelector<HTMLDetailsElement>('[data-story-menu]');
  const current = document.querySelector<HTMLElement>('[data-story-menu-current]');
  const article = document.querySelector<HTMLElement>('[data-story]');
  let active = '';

  const update = () => {
    // The current section is the last one whose top has passed 35% of the viewport.
    const line = window.innerHeight * 0.35;
    let id = targets[0]?.id ?? '';
    for (const el of targets) if (el.getBoundingClientRect().top <= line) id = el.id;
    if (id !== active) {
      active = id;
      for (const a of links) {
        if (a.hash === `#${id}`) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      }
      const label = links.find((a) => a.hash === `#${id}`)?.textContent?.trim();
      if (current && label) current.textContent = label;
    }
    if (bar && article) {
      const { top, height } = article.getBoundingClientRect();
      const progress = Math.min(1, Math.max(0, -top / Math.max(1, height - window.innerHeight)));
      bar.style.transform = `scaleX(${progress})`;
    }
  };

  let frame = 0;
  const schedule = () => {
    cancelAnimationFrame(frame);
    frame = requestAnimationFrame(update);
  };
  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule);
  // Close the mobile menu after choosing a section.
  menu?.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) menu.open = false;
  });
  update();
</script>
