---
import { citeId } from '../../lib/citations';

/** Superscript source markers linking to the Sources list: [1][3]. */
interface Props {
  numbers: number[];
  /** Unique per claim; gives each marker an id the Sources list can link back to. */
  prefix: string;
  tone?: 'light' | 'dark';
}
const { numbers, prefix, tone = 'light' } = Astro.props;
---

{numbers.length > 0 && (
  <sup class="ml-0.5 font-ui text-[11px] whitespace-nowrap">
    {numbers.map((n) => (
      <a
        id={citeId(prefix, n)}
        href={`#source-${n}`}
        class:list={[
          'scroll-mt-24 no-underline hover:underline',
          tone === 'dark' && 'text-gold hover:text-mist',
        ]}
        aria-label={`Source ${n}`}
      >
        [{n}]
      </a>
    ))}
  </sup>
)}
