---
/** Superscript source markers linking to the Sources list: [1][3]. */
interface Props {
  numbers: number[];
  tone?: 'light' | 'dark';
}
const { numbers, tone = 'light' } = Astro.props;
---

{numbers.length > 0 && (
  <sup class="ml-0.5 font-ui text-[11px] whitespace-nowrap">
    {numbers.map((n) => (
      <a
        href={`#source-${n}`}
        class:list={[
          'no-underline hover:underline',
          tone === 'dark' && 'text-gold hover:text-mist',
        ]}
        aria-label={`Source ${n}`}
      >
        [{n}]
      </a>
    ))}
  </sup>
)}
