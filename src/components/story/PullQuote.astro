---
/** A highlighted quotation. Only for sourced quotations — attribution is required. */
interface Props {
  attribution: string;
  sourceNumber?: number;
}
const { attribution, sourceNumber } = Astro.props;
---

<figure class="m-0 border-y border-sepia py-6 text-center">
  <blockquote class="m-0 font-display text-2xl leading-snug text-umber italic sm:text-3xl">
    <slot />
  </blockquote>
  <figcaption class="mt-3 font-ui text-sm text-burnt">
    — {attribution}
    {sourceNumber && <a href={`#source-${sourceNumber}`}>[{sourceNumber}]</a>}
  </figcaption>
</figure>
