---
interface Props {
  size?: number;
  label?: string;
}
const { size = 36, label = 'LS' } = Astro.props;
---

<span
  aria-hidden="true"
  class="inline-flex shrink-0 items-center justify-center rounded-full font-sc text-parchment shadow-[0_1px_0_#1d0a0e]"
  style={`width:${size}px;height:${size}px;font-size:${Math.round(size * 0.4)}px;background:radial-gradient(circle at 38% 34%,#8E2B38,#6E1F2A 55%,#4A121B)`}
>
  {label}
</span>
