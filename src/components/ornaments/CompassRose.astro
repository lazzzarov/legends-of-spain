---
interface Props {
  size?: number;
  class?: string;
}
const { size = 88, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 100 100"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  <circle cx="50" cy="50" r="46" fill="none" stroke="#8B5A2B" stroke-width="1"></circle>
  <circle
    cx="50"
    cy="50"
    r="38"
    fill="none"
    stroke="#8B5A2B"
    stroke-width="0.6"
    stroke-dasharray="2 3"
  ></circle>
  <polygon points="50,4 56,50 50,96 44,50" fill="#3B2416"></polygon>
  <polygon points="4,50 50,44 96,50 50,56" fill="#8B5A2B"></polygon>
  <polygon points="18,18 52,48 82,82 48,52" fill="#B8954A" opacity="0.7"></polygon>
  <polygon points="82,18 52,52 18,82 48,48" fill="#B8954A" opacity="0.7"></polygon>
  <circle cx="50" cy="50" r="4" fill="#FAF4E6" stroke="#3B2416"></circle>
</svg>
