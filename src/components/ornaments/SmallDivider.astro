---
/** A quieter divider between chapters inside a panel. */
---

<svg
  class="mx-auto block h-5 w-full max-w-xl"
  viewBox="0 0 600 20"
  preserveAspectRatio="xMidYMid meet"
  aria-hidden="true"
  focusable="false"
>
  <line x1="40" y1="10" x2="270" y2="10" stroke="#C08A4D"></line>
  <line x1="330" y1="10" x2="560" y2="10" stroke="#C08A4D"></line>
  <circle cx="300" cy="10" r="4" fill="none" stroke="#3B2416"></circle>
  <circle cx="300" cy="10" r="1.5" fill="#B8954A"></circle>
</svg>
