---
import type { LegendEntry } from '../../lib/content';
import { legendPath } from '../../lib/paths';
import { lifespan } from '../../lib/legends';

interface Props {
  legend: LegendEntry;
}
const { legend } = Astro.props;
const d = legend.data;
const initials = d.name.display
  .split(/\s+/)
  .filter((w) => /^\p{Lu}/u.test(w))
  .map((w) => w[0])
  .join('')
  .slice(0, 3);
---

<article class="panel flex h-full flex-col transition-transform hover:-translate-y-1">
  <div
    class="mx-3 mt-3 flex h-56 items-center justify-center border border-burnt"
    style="background:repeating-linear-gradient(135deg,#E9D8B5 0 3px,#DCC59A 3px 4px)"
    aria-hidden="true"
  >
    <span class="font-display text-7xl text-burnt/60">{initials}</span>
  </div>
  <div class="flex grow flex-col gap-2.5 p-5">
    <p class="eyebrow m-0">
      {d.role} · {lifespan(d.dates)}
    </p>
    <h3 class="m-0 font-display text-3xl leading-tight font-normal text-umber">
      <a href={legendPath(legend.id)} class="text-umber no-underline after:absolute after:inset-0">
        {d.name.display}
      </a>
    </h3>
    <p class="m-0 text-[17px] leading-normal text-umber italic">{d.tagline}</p>
    <p class="m-0 border-t border-dashed border-caramel pt-2.5 font-ui text-[13px] text-burnt">
      ◆ {d.mainAchievement}
    </p>
    {d.review.status === 'placeholder' && (
      <p class="m-0 font-ui text-xs font-semibold text-burgundy">Template placeholder</p>
    )}
  </div>
</article>

<style>
  article {
    position: relative;
  }
</style>
