---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComicViewer from '../../components/media/ComicViewer.astro';
import Portrait from '../../components/media/Portrait.astro';
import VideoPlayer from '../../components/media/VideoPlayer.astro';
import SmallDivider from '../../components/ornaments/SmallDivider.astro';
import Chapter from '../../components/story/Chapter.astro';
import ChapterNav from '../../components/story/ChapterNav.astro';
import FactsNotebook from '../../components/story/FactsNotebook.astro';
import LegendOrHistory from '../../components/story/LegendOrHistory.astro';
import MovieSection from '../../components/story/MovieSection.astro';
import OtherSide from '../../components/story/OtherSide.astro';
import Places from '../../components/story/Places.astro';
import SourcesList from '../../components/story/SourcesList.astro';
import StatusBanner from '../../components/story/StatusBanner.astro';
import { buildCitationIndex } from '../../lib/citations';
import { getLegends, type LegendEntry } from '../../lib/content';
import { legendJsonLd } from '../../lib/jsonld';
import { isVisible, lifespan, showDrafts } from '../../lib/legends';
import { legendPath, withBase } from '../../lib/paths';
import StoryNavigator from '../../components/story/StoryNavigator.astro';
import RelatedLegends from '../../components/story/RelatedLegends.astro';
import TimelinePosition from '../../components/timeline/TimelinePosition.astro';
import { CATEGORY_LABEL, CHAPTER_NUMERAL, VALUE_LABEL, centuryLabel } from '../../i18n/en';

export const getStaticPaths = (async () => {
  const legends = await getLegends();
  const byId = new Map(legends.map((l) => [l.id, l]));
  return legends.map((legend, i) => ({
    params: { slug: legend.id },
    props: {
      legend,
      all: legends,
      next: legends[(i + 1) % legends.length]!,
      // Only related legends that are visible in this build.
      related: legend.data.related.map((id) => byId.get(id)).filter((l): l is LegendEntry => !!l),
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  legend: LegendEntry;
  all: LegendEntry[];
  next: LegendEntry;
  related: LegendEntry[];
}
const { legend, all, next, related } = Astro.props;
const d = legend.data;
const mediaById = new Map(d.media.map((m) => [m.id, m]));
const portrait = mediaById.get(d.portrait)!;
const { numbers: cite, backlinks } = buildCitationIndex(d);

// Video and comic stay hidden until they exist (approved decision): a video only once
// published; a comic once past placeholder and visible under the review gate.
const video = d.video?.status === 'published' ? d.video : undefined;
const comic =
  d.comic && d.comic.status !== 'placeholder' && isVisible(d.comic.status, showDrafts())
    ? d.comic
    : undefined;

const sections = [
  video && { id: 'video', label: 'The Video' },
  d.facts.length > 0 && { id: 'facts', label: 'Key Facts' },
  comic && { id: 'comic', label: 'The Comic' },
  d.movie && { id: 'movie', label: 'Why This Deserves a Movie' },
  d.myths.length > 0 && { id: 'myths', label: 'Legend or History?' },
  { id: 'other-side', label: 'The Other Side of the Story' },
  d.places.length > 0 && { id: 'places', label: 'Places to Visit' },
  d.sources.length > 0 && { id: 'sources', label: 'Sources' },
].filter((s): s is { id: string; label: string } => Boolean(s));
const tocItems = [
  ...d.chapters.map((c) => ({ id: c.key, label: `${CHAPTER_NUMERAL[c.key]} · ${c.title}` })),
  ...sections,
];

const description = d.seo?.description ?? d.tagline;
const jsonLd = JSON.stringify(legendJsonLd(legend.id, d, Astro.site!));
---

<BaseLayout
  title={d.seo?.title ?? d.name.display}
  description={description}
  type="article"
  image={withBase(`og/${legend.id}.png`)}
  noindex={!isVisible(d.review.status, false)}
>
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLd} />
  <StatusBanner status={d.review.status} />

  <section class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-12 gap-y-8 px-4 pt-12 pb-10 sm:px-6 sm:pt-14">
    <div class="w-full max-w-[380px] flex-[0_1_380px]">
      <Portrait slug={legend.id} name={d.name.display} media={portrait} loading="eager" />
    </div>
    <header class="flex min-w-0 flex-[1_1_480px] flex-col gap-4">
      <p class="eyebrow m-0">
        Chapter {d.order} of the Book · {lifespan(d.dates)}
      </p>
      <h1 class="m-0 font-display text-[clamp(2.75rem,6vw,5rem)] leading-none font-normal text-umber">
        {d.name.display}
      </h1>
      <p class="m-0 font-display text-[clamp(1.375rem,2.4vw,1.875rem)] leading-snug text-burgundy italic">
        {d.tagline}
      </p>
      <p class="m-0 max-w-[620px] text-lg leading-relaxed sm:text-[19px]">{d.hook}</p>
      <ul
        class="m-0 flex list-none flex-wrap gap-2 p-0 font-ui text-[13px]"
        aria-label="At a glance"
      >
        {d.categories.map((c) => (
          <li class="border border-sepia px-3 py-1.5 text-umber">{CATEGORY_LABEL[c]}</li>
        ))}
        <li class="border border-sepia px-3 py-1.5 text-umber">{centuryLabel(d.centuries)}</li>
        <li class="bg-burgundy px-3 py-1.5 text-parchment">{VALUE_LABEL[d.values[0]!]}</li>
        <li class="border border-sepia px-3 py-1.5 text-umber">{d.origin.place}</li>
        <li class="px-1 py-1.5 text-burnt">2-minute read</li>
      </ul>
      {d.keyEvent && (
        <p class="m-0">
          <a href={withBase(`#story/${legend.id}`)} class="btn-primary text-lg" data-play-story>
            Play the story <span aria-hidden="true">▸</span>
          </a>
        </p>
      )}
    </header>
  </section>

  <StoryNavigator items={tocItems} />

  <div class="mx-auto flex max-w-6xl flex-wrap items-start gap-x-12 gap-y-8 px-4 pt-6 pb-8 sm:px-6 lg:pt-0">
    <aside class="hidden flex-[0_0_220px] lg:block">
      <ChapterNav chapters={d.chapters} sections={sections} />
    </aside>

    <article class="flex min-w-0 flex-[999_1_600px] flex-col gap-14" data-story>
      <section aria-labelledby="story-title" class="panel flex flex-col gap-9 p-6 sm:p-12">
        <h2 id="story-title" class="sr-only">
          The story
        </h2>
        {d.chapters.map((c, i) => (
          <>
            {i > 0 && <SmallDivider />}
            <Chapter chapter={c} citations={cite(c.sources)} first={i === 0} />
          </>
        ))}
      </section>

      {video && (
        <VideoPlayer
          slug={legend.id}
          name={d.name.display}
          video={video}
          poster={video.poster ? mediaById.get(video.poster) : undefined}
        />
      )}
      {d.facts.length > 0 && <FactsNotebook facts={d.facts} cite={cite} />}
      {comic && <ComicViewer slug={legend.id} comic={comic} media={d.media} />}
      {d.movie && <MovieSection movie={d.movie} cite={cite} />}

      <div class="flex flex-wrap gap-6">
        {d.myths.length > 0 && <LegendOrHistory myths={d.myths} cite={cite} />}
        <OtherSide otherSide={d.otherSide} cite={cite} />
      </div>

      {d.places.length > 0 && <Places places={d.places} cite={cite} />}
      {d.sources.length > 0 && <SourcesList sources={d.sources} backlinks={backlinks} />}
      {related.length > 0 && <RelatedLegends legends={related} />}
      <TimelinePosition legends={all} slug={legend.id} />

      {next.id !== legend.id && (
        <a
          href={legendPath(next.id)}
          class="flex items-center justify-between gap-4 border border-umber bg-cream p-6 text-umber no-underline hover:shadow-lift"
        >
          <span class="flex flex-col gap-1">
            <span class="eyebrow">Turn the page</span>
            <span class="font-display text-[32px] leading-tight">{next.data.name.display}</span>
          </span>
          <span class="font-sc text-[22px] text-burgundy">Next chapter →</span>
        </a>
      )}
      <p class="m-0 font-ui text-sm">
        <a href={withBase('legends/')}>← All legends</a>
      </p>
    </article>
  </div>
</BaseLayout>
