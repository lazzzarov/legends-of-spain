---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Divider from '../../components/ornaments/Divider.astro';
import { getLegends, type LegendEntry } from '../../lib/content';
import { lifespan } from '../../lib/legends';
import { legendPath, withBase } from '../../lib/paths';

// Phase 1 skeleton: every section of the story template, rendered plainly.
// Phase 2–3 replace these blocks with the dedicated story components.
export const getStaticPaths = (async () => {
  const legends = await getLegends();
  return legends.map((legend, i) => ({
    params: { slug: legend.id },
    props: { legend, next: legends[(i + 1) % legends.length] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  legend: LegendEntry;
  next: LegendEntry;
}
const { legend, next } = Astro.props;
const d = legend.data;
const sourceIndex = new Map(d.sources.map((s, i) => [s.id, i + 1]));
const cite = (ids: string[]) => ids.map((id) => sourceIndex.get(id)).filter(Boolean);
const ROMAN = ['I', 'II', 'III', 'IV', 'V'];
---

<BaseLayout
  title={d.seo?.title ?? d.name.display}
  description={d.seo?.description ?? d.tagline}
  type="article"
  noindex={d.review.status === 'placeholder'}
>
  <article class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    {d.review.status === 'placeholder' && (
      <p class="mb-6 border border-burgundy bg-cream p-3 font-ui text-sm text-burgundy">
        Template placeholder — this page shows the story structure, not a real biography.
      </p>
    )}
    <header class="flex flex-col gap-4">
      <p class="eyebrow m-0">
        {d.role} · {lifespan(d.dates)} · {d.origin.place}
      </p>
      <h1 class="m-0 font-display text-[clamp(3rem,6vw,5rem)] leading-none font-normal text-umber">
        {d.name.display}
      </h1>
      <p class="m-0 font-display text-2xl leading-snug text-burgundy italic">{d.tagline}</p>
      <p class="m-0 text-lg leading-relaxed">{d.hook}</p>
    </header>

    <Divider class="my-10" />

    <section aria-labelledby="story" class="panel flex flex-col gap-8 p-6 sm:p-10">
      <h2 id="story" class="sr-only">
        The story
      </h2>
      {d.chapters.map((c, i) => (
        <section id={c.key} aria-labelledby={`${c.key}-title`}>
          <h3
            id={`${c.key}-title`}
            class="m-0 mb-2 font-[family-name:var(--font-display-sc)] text-3xl font-normal text-umber"
          >
            {ROMAN[i]} · {c.title}
          </h3>
          <p class="m-0 text-lg leading-relaxed">
            {c.body}
            {cite(c.sources).map((n) => (
              <sup class="font-ui text-xs">
                <a href={`#source-${n}`}>[{n}]</a>
              </sup>
            ))}
          </p>
          {c.more && (
            <details class="mt-3 border-t border-dashed border-caramel pt-2">
              <summary class="cursor-pointer font-[family-name:var(--font-display-sc)] text-burgundy">
                Read more
              </summary>
              <p class="mt-2 leading-relaxed">{c.more}</p>
            </details>
          )}
        </section>
      ))}
    </section>

    {d.facts.length > 0 && (
      <section aria-labelledby="facts-title" class="mt-12">
        <h2 id="facts-title" class="font-display text-4xl font-normal text-umber">
          Key Facts
        </h2>
        <dl class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-4">
          {d.facts.map((f) => (
            <div class="panel p-5">
              <dt class="eyebrow">{f.label}</dt>
              <dd class="m-0 font-display text-5xl text-umber">
                {f.value}
                {f.unit && <span class="text-2xl"> {f.unit}</span>}
              </dd>
              <dd class="m-0 mt-1">{f.explanation}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {d.movie && (
      <section
        aria-labelledby="movie-title"
        class="mt-12 border border-gold bg-ink p-6 text-parchment sm:p-10"
      >
        <p class="eyebrow m-0 text-gold">Cinematic interpretation</p>
        <h2 id="movie-title" class="mt-1 font-display text-4xl font-normal">
          Why This Deserves a Movie
        </h2>
        <p class="font-display text-2xl text-mist italic">
          “{d.movie.title}” — {d.movie.premise}
        </p>
        <ol class="leading-relaxed">
          {d.movie.moments.map((m) => (
            <li>{m.text}</li>
          ))}
        </ol>
      </section>
    )}

    {d.myths.length > 0 && (
      <section aria-labelledby="myths-title" class="mt-12">
        <h2 id="myths-title" class="font-display text-4xl font-normal text-umber">
          Legend or History?
        </h2>
        {d.myths.map((m) => (
          <div class="panel mb-4 p-5">
            <p class="m-0 italic">“{m.claim}”</p>
            <p class="mt-2 mb-0">{m.explanation}</p>
          </div>
        ))}
      </section>
    )}

    <section aria-labelledby="other-title" class="mt-12">
      <h2 id="other-title" class="font-display text-4xl font-normal text-burgundy">
        The Other Side of the Story
      </h2>
      <p class="text-lg leading-relaxed">{d.otherSide.body}</p>
    </section>

    {d.sources.length > 0 && (
      <section aria-labelledby="sources-title" class="mt-12 border-t border-sepia pt-6">
        <h2 id="sources-title" class="font-display text-3xl font-normal text-umber">
          Sources
        </h2>
        <ol class="leading-relaxed">
          {d.sources.map((s, i) => (
            <li id={`source-${i + 1}`}>
              {s.url ? <a href={s.url}>{s.title}</a> : s.title}
              {(s.author ?? s.institution) && <>. {s.author ?? s.institution}</>}
              {s.year && <>, {s.year}</>}.
            </li>
          ))}
        </ol>
      </section>
    )}

    {next.id !== legend.id && (
      <a href={legendPath(next.id)} class="panel mt-12 flex justify-between gap-4 p-6 no-underline">
        <span>
          <span class="eyebrow block">Turn the page</span>
          <span class="font-display text-3xl text-umber">{next.data.name.display}</span>
        </span>
        <span class="self-center font-[family-name:var(--font-display-sc)] text-xl">
          Next chapter →
        </span>
      </a>
    )}
    <p class="mt-10 font-ui text-sm">
      <a href={withBase('legends/')}>← All legends</a>
    </p>
  </article>
</BaseLayout>
