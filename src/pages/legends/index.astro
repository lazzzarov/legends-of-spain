---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/gallery/Gallery.astro';
import { getLegends } from '../../lib/content';

const legends = await getLegends();
---

<BaseLayout
  title="The Legends"
  description="Every explorer, commander and pioneer in the Legends of Spain chronicle, in book order."
>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <p class="eyebrow m-0">Table of contents</p>
    <h1 class="mt-1 mb-8 font-display text-5xl font-normal text-umber">The Legends</h1>
    <Gallery legends={legends} />
  </div>
</BaseLayout>
