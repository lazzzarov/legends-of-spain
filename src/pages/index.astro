---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompassRose from '../components/ornaments/CompassRose.astro';
import Divider from '../components/ornaments/Divider.astro';
import Gallery from '../components/gallery/Gallery.astro';
import { getLegends } from '../lib/content';
import { withBase } from '../lib/paths';

const legends = await getLegends();
---

<BaseLayout
  title="Legends of Spain"
  description="The extraordinary lives of Spanish explorers, commanders and pioneers — told in two minutes, sourced to the archive."
>
  <section class="mx-auto max-w-6xl px-4 pt-16 pb-12 sm:px-6">
    <div class="flex flex-col items-center gap-6 border border-sepia px-6 py-16 text-center outline outline-offset-8 outline-sepia">
      <CompassRose />
      <p class="eyebrow m-0">A chronicle of extraordinary lives · 1480 – 1836</p>
      <h1 class="m-0 max-w-4xl font-display text-[clamp(2.75rem,7vw,5.5rem)] leading-none font-normal text-umber">
        Legends Worthy of a Thousand Films
      </h1>
      <Divider />
      <p class="m-0 max-w-2xl text-[clamp(1.125rem,2vw,1.375rem)] leading-relaxed text-umber">
        Discover the extraordinary lives of Spanish explorers, commanders and pioneers who
        challenged the impossible — told in two minutes, sourced to the archive.
      </p>
      <a
        href="#legends"
        class="inline-flex min-h-13 items-center gap-2.5 border border-gold bg-umber px-8 font-[family-name:var(--font-display-sc)] text-xl tracking-wide text-parchment no-underline outline outline-offset-3 outline-umber hover:text-mist"
      >
        Open the Book <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section
    id="legends"
    class="mx-auto max-w-6xl px-4 pb-16 sm:px-6"
    aria-labelledby="legends-title"
  >
    <div class="mb-7 border-b border-sepia pb-4">
      <p class="eyebrow m-0">Table of contents</p>
      <h2 id="legends-title" class="m-0 font-display text-4xl font-normal text-umber">
        The Legends
      </h2>
    </div>
    <Gallery legends={legends} />
  </section>

  <section class="mx-auto max-w-3xl px-4 py-12 text-center sm:px-6">
    <p class="eyebrow m-0">Our promise</p>
    <h2 class="mt-2 mb-4 font-display text-4xl font-normal text-umber">History, not mythology</h2>
    <p class="m-0 text-lg leading-relaxed">
      We celebrate courage and ingenuity without hiding violence, controversy or the many hands
      behind every famous name. Every claim is labelled, every fact is sourced, and every AI image
      is marked as such.
    </p>
    <p class="mt-4">
      <a href={withBase('why/')} class="font-[family-name:var(--font-display-sc)] text-lg">
        Why we tell these stories →
      </a>
    </p>
  </section>
</BaseLayout>
