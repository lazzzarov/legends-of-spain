---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeaChart from '../components/story-mode/SeaChart.astro';
import StoryBar from '../components/story-mode/StoryBar.astro';
import StoryDeck from '../components/story-mode/StoryDeck.astro';
import { getLegends } from '../lib/content';
import { siteJsonLd } from '../lib/jsonld';
import { toTimeline } from '../lib/timeline';

// The home page is the book: the timeline is step 1, then every legend's story in order.
const items = toTimeline(await getLegends());
const description =
  'Fourteen Spanish explorers, commanders and pioneers, in the order their defining moments happened — each told in two minutes, sourced to the archive.';
const jsonLd = JSON.stringify(siteJsonLd(Astro.site!, description));
---

<BaseLayout title="Legends of Spain" description={description} stage>
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLd} />
  <div class="stage" data-story-stage data-mode="timeline">
    <SeaChart legends={items.map((i) => i.legend)} />
    {items.map((item, i) => (
      <StoryDeck legend={item.legend} step={i + 1} next={items[i + 1]?.legend} />
    ))}
    <StoryBar steps={items.map((i) => ({ slug: i.slug, name: i.name, year: i.eventYear }))} />
  </div>
</BaseLayout>

<script>
  import '../scripts/story-player';
</script>

<style>
  .stage {
    /* Room kept clear for the control bar at the bottom. */
    --bar-space: clamp(84px, 13vh, 112px);
    position: relative;
    height: calc(100svh - 66px);
    min-height: 560px;
    overflow: hidden;
  }
  @media (max-width: 767px) {
    /* The timeline may grow past a short phone screen; a story always fits the screen. */
    .stage[data-mode='timeline'] {
      height: auto;
      min-height: calc(100svh - 66px);
      overflow: visible;
    }
  }
</style>
