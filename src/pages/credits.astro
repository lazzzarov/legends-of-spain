---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLegends } from '../lib/content';
import { legendPath } from '../lib/paths';

// Generated from each legend's media registry, so credits can never drift from the assets used.
const legends = await getLegends();
const KIND_LABEL = {
  historical: 'Historical artwork',
  'original-illustration': 'Original illustration',
  'ai-generated': 'AI-generated illustration',
  photograph: 'Photograph',
} as const;
---

<BaseLayout
  title="Credits & Licenses"
  description="Every image and video used in Legends of Spain, with its creator, source and license, and our AI-disclosure policy."
>
  <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
    <h1 class="mt-0 mb-6 font-display text-5xl font-normal text-umber">Credits &amp; Licenses</h1>

    <section aria-labelledby="ai-policy" class="panel mb-10 p-6">
      <h2 id="ai-policy" class="mt-0 font-display text-3xl font-normal text-umber">
        Our AI-disclosure policy
      </h2>
      <ul class="mb-0 leading-relaxed">
        <li>
          Every image is labelled as historical artwork, original illustration, AI-generated
          illustration or photograph.
        </li>
        <li>An AI-generated image is never presented as an authentic historical portrait.</li>
        <li>
          Videos are AI-generated historical dramatizations and are labelled as such, with captions
          and a transcript.
        </li>
        <li>Comic dialogue is either a sourced quotation or clearly marked as dramatized.</li>
      </ul>
    </section>

    <section aria-labelledby="licenses">
      <h2 id="licenses" class="font-display text-3xl font-normal text-umber">
        Licenses
      </h2>
      <p class="leading-relaxed">
        Source code is released under the MIT License. Original written content is released under
        Creative Commons Attribution-ShareAlike 4.0. Images and videos keep their own licenses,
        listed below.
      </p>
    </section>

    {legends.map((legend) => (
      <section class="mt-10" aria-labelledby={`credits-${legend.id}`}>
        <h2 id={`credits-${legend.id}`} class="font-display text-2xl font-normal text-umber">
          <a href={legendPath(legend.id)}>{legend.data.name.display}</a>
        </h2>
        <ul class="leading-relaxed">
          {legend.data.media.map((m) => (
            <li>
              <strong>{m.title}</strong> — {KIND_LABEL[m.kind]}
              {m.posthumous && ' (posthumous)'}
              {m.creator && <>, {m.creator}</>}
              {m.date && <>, {m.date}</>}
              {m.institution && <>, {m.institution}</>}. License: {m.license}. {m.attribution}
              {m.sourceUrl && (
                <>
                  {' '}
                  <a href={m.sourceUrl}>Source</a>
                </>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
